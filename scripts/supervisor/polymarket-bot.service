[Unit]
# Constantine — autonomous bot supervisor (Linux systemd).
#
# Install:
#   sudo cp scripts/supervisor/polymarket-bot.service /etc/systemd/system/
#   sudo cp scripts/supervisor/polymarket-sidecar.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable polymarket-bot polymarket-sidecar
#   sudo systemctl start  polymarket-bot polymarket-sidecar
#
# View logs:
#   journalctl -u polymarket-bot -f
#
# IMPORTANT: edit User= and WorkingDirectory= below before installing.

Description=Constantine Polymarket trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME_HERE
WorkingDirectory=/home/YOUR_USERNAME_HERE/Constantine
EnvironmentFile=/home/YOUR_USERNAME_HERE/Constantine/.env
ExecStart=/home/YOUR_USERNAME_HERE/Constantine/target/release/polymarket-bot
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# Resource limits
MemoryMax=2G
CPUQuota=200%

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/YOUR_USERNAME_HERE/Constantine/data

[Install]
WantedBy=multi-user.target
